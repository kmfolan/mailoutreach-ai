# ── Server ───────────────────────────────────────────────────────────────────
PORT=4021
NODE_ENV=development
COOKIE_SECURE=false

# ── Auth ─────────────────────────────────────────────────────────────────────
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme
AUTH_SESSION_SECRET=change-this-to-a-long-random-string

# ── AI: OpenAI (research, classification, optimization) ───────────────────────
OPENAI_API_KEY=sk-...

# ── AI: Anthropic (email writing, reply drafting) ─────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Discovery: Google Maps Places API ─────────────────────────────────────────
GOOGLE_MAPS_API_KEY=AIza...

# ── SEO Audit: DataForSEO ────────────────────────────────────────────────────
# Sign up at https://dataforseo.com — pay-per-call, ~$0.002 per domain audit.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ── Enrichment: Snov.io ───────────────────────────────────────────────────────
SNOV_CLIENT_ID=
SNOV_CLIENT_SECRET=

# ── SMTP Sending — Multi-Provider Setup ──────────────────────────────────────
#
# You can configure up to 20 sending accounts (SMTP_1_* through SMTP_20_*).
# Accounts are rotated round-robin across sends automatically.
# Set SMTP_n_PROVIDER to one of: microsoft | gmail | yahoo | turbify
# — this fills in host/port/secure automatically. Override any field explicitly.
#
# DELIVERABILITY RANKING (cold B2B outreach):
#   1. Microsoft 365  — best inbox placement, strongest IP reputation, $6/mailbox
#   2. Google Workspace (gmail) — excellent for Gmail recipients, Google suspends
#      cold outreach accounts faster, $6/mailbox
#   3. Turbify / Yahoo Business — cheapest ($1.50/mailbox) but weaker IP reputation;
#      good for testing or supplemental volume, not recommended as sole provider
#
# REQUIRED for all accounts: get an APP PASSWORD (not your login password).
#   Microsoft 365: https://mysignins.microsoft.com/security-info
#   Google:        https://myaccount.google.com/apppasswords  (needs 2FA on)
#   Turbify/Yahoo: Account Settings → Security → Generate App Password
#
# ─── Account 1: Microsoft 365 ────────────────────────────────────────────────
SMTP_1_PROVIDER=microsoft
SMTP_1_USER=outreach@yourdomain.com
SMTP_1_PASS=your-app-password
SMTP_1_FROM_NAME=Your Name
# Optional overrides (preset fills these from PROVIDER):
# SMTP_1_HOST=smtp.office365.com
# SMTP_1_PORT=587
# SMTP_1_SECURE=false

# ─── Account 2: Google Workspace ─────────────────────────────────────────────
SMTP_2_PROVIDER=gmail
SMTP_2_USER=outreach@yourdomain.com
SMTP_2_PASS=your-app-password
SMTP_2_FROM_NAME=Your Name
# Optional overrides:
# SMTP_2_HOST=smtp.gmail.com
# SMTP_2_PORT=587
# SMTP_2_SECURE=false

# ─── Account 3: Turbify / Yahoo Business ─────────────────────────────────────
SMTP_3_PROVIDER=turbify
SMTP_3_USER=outreach@yourdomain.com
SMTP_3_PASS=your-app-password
SMTP_3_FROM_NAME=Your Name
# Optional overrides:
# SMTP_3_HOST=smtp.bizmail.yahoo.com
# SMTP_3_PORT=465
# SMTP_3_SECURE=true

# ─── Accounts 4–20: add more in the same pattern ─────────────────────────────
# SMTP_4_PROVIDER=microsoft
# SMTP_4_USER=outreach2@yourdomain.com
# SMTP_4_PASS=
# SMTP_4_FROM_NAME=

# ─── Legacy single-account fallback (still works if no SMTP_n_* vars set) ────
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=outreach@yourdomain.com
# SMTP_PASS=your-app-password
# SMTP_FROM_NAME=Your Name
# SMTP_PROVIDER=microsoft

# ── Tracking ─────────────────────────────────────────────────────────────────
# Public hostname for tracking pixel, click-redirect, and audit page URLs.
# Must be reachable from the recipient's email client.
TRACKING_HOST=yourdomain.com
