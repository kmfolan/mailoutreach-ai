# ── Server ───────────────────────────────────────────────────────────────────
PORT=4021
NODE_ENV=development
COOKIE_SECURE=false

# ── Auth ─────────────────────────────────────────────────────────────────────
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme
AUTH_SESSION_SECRET=change-this-to-a-long-random-string

# ── AI: OpenAI (research, classification, optimization) ───────────────────────
OPENAI_API_KEY=sk-...

# ── AI: Anthropic (email writing, reply drafting) ─────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Discovery: Google Maps Places API ─────────────────────────────────────────
GOOGLE_MAPS_API_KEY=AIza...

# ── SEO Audit: DataForSEO ────────────────────────────────────────────────────
# Used by Agent 1.5 to pull real keyword rankings and organic traffic per prospect.
# Sign up at https://dataforseo.com — pay-per-call, ~$0.002 per domain audit.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ── Enrichment: Snov.io ───────────────────────────────────────────────────────
SNOV_CLIENT_ID=
SNOV_CLIENT_SECRET=

# ── SMTP sending (Microsoft 365 / Gmail / any provider) ──────────────────────
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=outreach@yourdomain.com
SMTP_PASS=your-app-password
SMTP_FROM_NAME=Your Name

# ── Tracking ─────────────────────────────────────────────────────────────────
# Public hostname used in tracking pixel and click-redirect URLs.
# Must be reachable from the recipient's email client.
TRACKING_HOST=yourdomain.com
